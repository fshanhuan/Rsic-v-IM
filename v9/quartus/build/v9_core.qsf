# =============================================================================
# quartus/build/v9_core.qsf — 只综合 CPU 核心（不含 IROM/DRAM）的资源测量工程
# -----------------------------------------------------------------------------
# 用法（在 quartus/build 目录下）：
#     E:\FPGA\QuartusII_13.0\quartus\bin64\quartus_map.exe v9_core --read_settings_files=on
# 然后看 output_files/v9_core.map.rpt 的 "Analysis & Synthesis Resource Usage"。
#
# 与 v9_board.qsf 的区别：
#   TOP_LEVEL_ENTITY = syn_core_only（只是把 myCPU 的端口引出来的外壳），
#   存储器不算在内，这样得到的 LE/寄存器数才是「CPU 逻辑本身」的规模。
#
# 注意：Quartus II 13.0 的 Verilog 解析器**不支持 SystemVerilog**
#   （always_ff / always_comb / logic 全部报 Error 10170），
#   所以本工程在当前工具版本下**必然编译失败**，保留它是为了：
#     1) 记录「用 Q13.0 试过、失败原因是什么」；
#     2) 换到 Quartus Prime Lite 17.0+（免费，支持 SystemVerilog）后可直接复用。
#   实测见 ../../syn/quartus_13_limitation.md
# =============================================================================
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY syn_core_only
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/quartus/build/syn_core_only.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/myCPU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/IFU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/ICache.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/Branch_Predictor.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/IDU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/Reg_Stack.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/RegisterFile.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/CSR.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/EXU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/ALU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/experimental/MDU_pipelined.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/LSU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/DCache.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/WBU.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/Data_hazard.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/Control.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/add.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/sext.sv"
set_global_assignment -name VERILOG_FILE "E:/share doc/v9/Reg.sv"
set_global_assignment -name SEARCH_PATH "E:/share doc/v9"
set_global_assignment -name SEARCH_PATH "E:/share doc/v9/experimental"
set_global_assignment -name SDC_FILE "E:/share doc/v9/syn/v9.sdc"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_core
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
